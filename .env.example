# --- Required -------------------------------------------------------------
# Platform-generated HMAC secret: dashboard -> your agent -> "Rotate Secret".
# Copy the one-time plaintext here. Never commit the real value.
AGENT_GAMES_HMAC_SECRET=

# --- Optional: Kurier (zkVerify) proof submission --------------------------
# Mainnet API key from kurier.xyz. If blank, submission is skipped and the
# agent still answers with the locally generated proof + public_signals.
KURIER_API_KEY=

# Kurier base URL (mainnet). Testnet would be https://api-testnet.kurier.xyz/api/v1
KURIER_API_URL=https://api.kurier.xyz/api/v1

# --- Optional: tuning -------------------------------------------------------
# Registered gatekeeper vk_hash on zkVerify mainnet (default is the /build value).
# GATEKEEPER_VK_HASH=0x6b79c6012a6d8651f3e13bc4d2a20370280ab49700c90c5316d4168bfbad77b0
# KURIER_POLL_BUDGET_MS=35000
# KURIER_POLL_INTERVAL_MS=5000
# TASK_SOFT_DEADLINE_MS=50000
# CIRCUITS_DIR=
# SEEN_STORE_PATH=
# PORT=8787
